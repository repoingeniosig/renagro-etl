[Unit]
Description=RENAGRO ETL Worker - JSON Save
After=network.target postgresql.service redis.service rabbitmq-server.service renagro-api.service
Wants=postgresql.service redis.service rabbitmq-server.service
BindsTo=renagro-api.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/renagro-etl-process
Environment="PATH=/opt/renagro-etl-process/venv/bin"
EnvironmentFile=/opt/renagro-etl-process/.env

ExecStart=/opt/renagro-etl-process/venv/bin/python -m src.workers json_save

# Reintentos automáticos
Restart=always
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=300

# Límites de recursos (4 CPUs, 16GB RAM)
LimitNOFILE=65536
MemoryLimit=2G
MemoryHigh=1536M
CPUQuota=75%
CPUWeight=80

# Logging (systemd journal)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=renagro-worker-json-save

[Install]
WantedBy=multi-user.target
