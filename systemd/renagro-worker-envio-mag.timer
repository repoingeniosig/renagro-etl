[Unit]
Description=Timer para construcción de JSONs MAG
Requires=renagro-worker-envio-mag.service

[Timer]
# Ejecutar 2 minutos después del boot
OnBootSec=2min
# Ejecutar cada 5 minutos después de la última ejecución
OnUnitActiveSec=5min
# Servicio a ejecutar
Unit=renagro-worker-envio-mag.service

[Install]
WantedBy=timers.target
