# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=renagro_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=sc_renagro_mag

# Redis Configuration (para cache de mapeos YAML)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL=3600
REDIS_ENABLED=true

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Queue Names
QUEUE_JSON_SAVE=renagro.json.save
QUEUE_ETL_TRANSFORM=renagro.etl.transform
QUEUE_DB_INSERT=renagro.db.insert

# Retry Queues (con TTL para backoff exponencial)
QUEUE_JSON_SAVE_RETRY=renagro.json.save.retry
QUEUE_ETL_TRANSFORM_RETRY=renagro.etl.transform.retry
QUEUE_DB_INSERT_RETRY=renagro.db.insert.retry

# Dead Letter Queues (errores permanentes después de MAX_RETRIES)
QUEUE_JSON_SAVE_DLQ=renagro.json.save.dlq
QUEUE_ETL_TRANSFORM_DLQ=renagro.etl.transform.dlq
QUEUE_DB_INSERT_DLQ=renagro.db.insert.dlq

# Envío MAG Queues
QUEUE_ENVIO_MAG_SEND=renagro.envio.mag.send
QUEUE_ENVIO_MAG_SEND_RETRY=renagro.envio.mag.send.retry
QUEUE_ENVIO_MAG_SEND_DLQ=renagro.envio.mag.send.dlq

# Retry Configuration
MAX_RETRIES=3

# API Configuration (para futura integración)
API_EXTERNAL_URL=https://api.example.com
API_EXTERNAL_KEY=your_api_key_here

# API REST Configuration (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_BASIC_USER=admin
API_BASIC_PASSWORD=admin123

# Application Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development
# Debug para ver inserts de bd y transformaciones
DEBUG=false
# DEBUG para ver logs en consola de los pasos CLI
DEBUG_CLI=false
LOG_DIR=logs

# MAG Envio Configuration
BATCH_SIZE_SEND_MAG=1000
DEBUG_JSON_OUTPUT=false
UPPERCASE_JSON_MAG=false  # true para convertir strings a MAYÚSCULAS en JSONs enviados a MAG (emails NO se convierten)

# Intervalos de revisión (solo para ENVIRONMENT=development)
# En producción se usan systemd timers
ENVIO_MAG_CHECK_INTERVAL=300        # 5 minutos (construcción de JSONs)
ENVIO_MAG_SENDER_CHECK_INTERVAL=120 # 2 minutos (envío a API)

# API Remota RENAGRO (envío de JSONs)
RENAGRO_ENDPOINT=https://api.renagro.gob.ec/v1/boletas
PARALLEL_REQUESTS_SEND_MAG=10
MAX_RETRY_ATTEMPTS=3

# MAG RENAGRO Authentication
MAG_RENAGRO_AUTH_URL=https://api.mag.gob.ec/auth/login
MAG_RENAGRO_ID=87
MAG_RENAGRO_USER=1722651039
MAG_RENAGRO_PASSWORD=483ac9475430cb13f4a891a0f5149637
MAG_RENAGRO_IP_LAN=192.168.1.5
MAG_RENAGRO_IP_WAN=10.101.102.1
