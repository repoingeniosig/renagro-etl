# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=renagro_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=sc_renagro_mag

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Queue Names
QUEUE_JSON_SAVE=renagro.json.save
QUEUE_ETL_TRANSFORM=renagro.etl.transform
QUEUE_DB_INSERT=renagro.db.insert

# API Configuration (para futura integración)
API_EXTERNAL_URL=https://api.example.com
API_EXTERNAL_KEY=your_api_key_here

# Application Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development
DEBUG=true
